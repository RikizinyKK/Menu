-- 1. INTRODUÇÃO VISUAL (SPLASH SCREEN RIKIZERA)
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local IntroScreen = Instance.new("ScreenGui")
IntroScreen.Name = "RikizeraIntro"
IntroScreen.Parent = CoreGui

local Fundo = Instance.new("Frame")
Fundo.Size = UDim2.new(1, 0, 1, 0)
Fundo.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
Fundo.Parent = IntroScreen

local TextoIntro = Instance.new("TextLabel")
TextoIntro.Size = UDim2.new(1, 0, 0, 100)
TextoIntro.Position = UDim2.new(0, 0, 0.4, 0)
TextoIntro.BackgroundTransparency = 1
TextoIntro.Text = "RIKIZERA"
TextoIntro.TextColor3 = Color3.fromRGB(255, 255, 255)
TextoIntro.Font = Enum.Font.SourceSansBold
TextoIntro.TextSize = 60
TextoIntro.Parent = Fundo

task.wait(5)
local infoTween = TweenInfo.new(1.5, Enum.EasingStyle.Linear)
local t1 = TweenService:Create(Fundo, infoTween, {BackgroundTransparency = 1})
local t2 = TweenService:Create(TextoIntro, infoTween, {TextTransparency = 1})
t1:Play()
t2:Play()
t1.Completed:Connect(function()
    IntroScreen:Destroy()
end)

-- 2. CARREGANDO A BIBLIOTECA KAVO (MOBILE FRIENDLY)
local Kavo = loadstring(game:HttpGet("https://githubusercontent.com"))()
local Janela = Kavo.CreateLib("RIKIZERA MULTIHACK V9", "Mint") -- Tema Verde Neon/Preto

-- 3. CRIANDO AS ABAS
local AbaPlayer = Janela:NewTab("Player")
local SecPlayer = AbaPlayer:NewSection("Atributos")

local AbaTroll = Janela:NewTab("Troll")
local SecTroll = AbaTroll:NewSection("Zoeira")

local AbaTp = Janela:NewTab("Teleporte")
local SecTp = AbaTp:NewSection("Locais Brookhaven")

local AbaEsp = Janela:NewTab("ESP Wallhack")
local SecEsp = AbaEsp:NewSection("Rastreador")

-- 4. FUNÇÕES DA ABA PLAYER
local noclipAtivado = false

SecPlayer:NewToggle("Super Velocidade (80)", "Te deixa rapido", function(v)
    local h = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
    if h then h.WalkSpeed = v and 80 or 16 end
end)

SecPlayer:NewToggle("Super Pulo (100)", "Pulo alto", function(v)
    local h = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
    if h then h.UseJumpPower = true h.JumpPower = v and 100 or 50 end
end)

SecPlayer:NewToggle("NoClip (Atravessar Paredes)", "Vira fantasma", function(v)
    noclipAtivado = v
end)

game:GetService("RunService").Stepped:Connect(function()
    if noclipAtivado and game.Players.LocalPlayer.Character then
        for _, p in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

SecPlayer:NewButton("Forçar Sentar", "Senta no chao", function()
    local h = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
    if h then h.Sit = true end
end)

-- 5. FUNÇÕES DA ABA TROLL
SecTroll:NewToggle("Gravidade da Lua (30)", "Zera a gravidade", function(v)
    workspace.Gravity = v and 30 or 196.2
end)

SecTroll:NewButton("Ativar Visão Noturna", "Clareia tudo", function()
    game.Lighting.Ambient = Color3.fromRGB(255, 255, 255)
end)

SecTroll:NewButton("Neblina de Terror", "Nevoatensa", function()
    game.Lighting.FogEnd = 30
    game.Lighting.FogColor = Color3.fromRGB(0, 0, 0)
end)

-- 6. FUNÇÕES DA ABA TELEPORTE
local function teleportarPara(pos)
    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = pos end
end

SecTp:NewButton("Banco / Cofre", "Vai pro cofre", function()
    teleportarPara(CFrame.new(-442, 23, -284))
end)

SecTp:NewButton("Delegacia", "Vai pra prisao", function()
    teleportarPara(CFrame.new(-365, 24, -195))
end)

SecTp:NewButton("Praça Central", "Vai pro centro", function()
    teleportarPara(CFrame.new(-414, 21, -73))
end)

-- 7. FUNÇÕES DA ABA ESP
local espAtivado = false

local function aplicarEsp(j)
    if j == game.Players.LocalPlayer then return end
    local function criarTags()
        local c = j.Character or j.CharacterAdded:Wait()
        local h = c:WaitForChild("Head", 5)
        if not h then return end
        if h:FindFirstChild("RikizeraESP") then h.RikizeraESP:Destroy() end

        local b = Instance.new("BillboardGui")
        b.Name = "RikizeraESP" b.Size = UDim2.new(0, 200, 0, 50)
        b.AlwaysOnTop = true b.ExtentsOffset = Vector3.new(0, 3, 0)
        b.Enabled = espAtivado b.Parent = h

        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 1, 0) l.BackgroundTransparency = 1
        l.Text = j.Name l.TextColor3 = Color3.fromRGB(0, 255, 150)
        l.TextStrokeTransparency = 0 l.Font = Enum.Font.SourceSansBold
        l.TextSize = 16 l.Parent = b
    end
    j.CharacterAdded:Connect(criarTags)
    if j.Character then criarTags() end
end

game.Players.PlayerAdded:Connect(aplicarEsp)
for _, p in pairs(game.Players:GetPlayers()) do aplicarEsp(p) end

SecEsp:NewToggle("Ativar ESP Names", "Ver nicks", function(v)
    espAtivado = v
    for _, p in pairs(game.Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("RikizeraESP") then
            p.Character.Head.RikizeraESP.Enabled = espAtivado
        end
    end
end)
