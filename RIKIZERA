-- 5. MOTOR DO ESP INFALÍVEL (MÉTODO BILLBOARDGUI)
local localPlayer = game.Players.LocalPlayer

local function aplicarEsp(jogador)
    if jogador == localPlayer then return end

    local function criarTags()
        local char = jogador.Character or jogador.CharacterAdded:Wait()
        local head = char:WaitForChild("Head", 5)
        if not head then return end

        -- Evita duplicar tags
        if head:FindFirstChild("RikizeraESP") then head.RikizeraESP:Destroy() end

        -- Cria a interface presa na cabeça do outro jogador
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "RikizeraESP"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.AlwaysOnTop = true -- Faz aparecer através das paredes do mapa!
        billboard.ExtentsOffset = Vector3.new(0, 3, 0) -- Fica um pouco acima do boneco
        billboard.Enabled = espAtivado
        billboard.Parent = head

        -- Texto com o nome real do jogador
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1 -- Sem fundo cinza chato
        label.Text = jogador.Name
        label.TextColor3 = Color3.fromRGB(0, 255, 150) -- Verde neon igual o menu
        label.TextStrokeTransparency = 0 -- Linha preta em volta da letra para dar destaque
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 16
        label.Parent = billboard
    end

    jogador.CharacterAdded:Connect(criarTags)
    if jogador.Character then criarTags() end
end

-- Monitora o servidor inteiro
game.Players.PlayerAdded:Connect(aplicarEsp)
for _, p in pairs(game.Players:GetPlayers()) do aplicarEsp(p) end

-- CLIQUE DO BOTÃO DO ESP
BtnEsp.MouseButton1Click:Connect(function()
    espAtivado = not espAtivado
    if espAtivado then
        BtnEsp.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        BtnEsp.Text = "ESP WALLHACK: ON"
    else
        BtnEsp.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        BtnEsp.Text = "ESP WALLHACK: OFF"
    end
    
    -- Ativa/Desativa os nomes de todo mundo na hora do clique
    for _, p in pairs(game.Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("RikizeraESP") then
            p.Character.Head.RikizeraESP.Enabled = espAtivado
        end
    end
end)

