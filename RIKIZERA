-- FUNÇÕES DE CRIAÇÃO DE COMPONENTES CUSTOMIZADOS
------------------------------------------------------------------------
local function CriarBotao(texto, aba, callback)
    local Botao = Instance.new("TextButton")
    Botao.Size = UDim2.new(1, 0, 0, 35)
    Botao.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    Botao.Text = texto
    Botao.TextColor3 = Color3.fromRGB(255, 255, 255)
    Botao.Font = Enum.Font.SourceSans
    Botao.TextSize = 16
    Botao.Parent = tabFrames[aba]

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 5)
    UICorner.Parent = Botao

    Botao.MouseButton1Click:Connect(callback)
    return Botao
end

local function CriarAlternador(texto, aba, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, 0, 0, 35)
    Container.BackgroundTransparency = 1
    Container.Parent = tabFrames[aba]

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.8, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = "  " .. texto
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.SourceSans
    Label.TextSize = 16
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Container

    local Checkbox = Instance.new("TextButton")
    Checkbox.Size = UDim2.new(0, 25, 0, 25)
    Checkbox.Position = UDim2.new(1, -35, 0.5, -12)
    Checkbox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Checkbox.BorderColor3 = Color3.fromRGB(0, 0, 0)
    Checkbox.BorderSizePixel = 2
    Checkbox.Text = ""
    Checkbox.Parent = Container

    local UICornerBox = Instance.new("UICorner")
    UICornerBox.CornerRadius = UDim.new(0, 4)
    UICornerBox.Parent = Checkbox

    local estado = false
    Checkbox.MouseButton1Click:Connect(function()
        estado = not estado
        Checkbox.BackgroundColor3 = estado and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(50, 50, 50)
        callback(estado)
    end)
    return Checkbox
end

local function CriarInputNumero(texto, aba, callback)
    local FrameInput = Instance.new("Frame")
    FrameInput.Size = UDim2.new(1, 0, 0, 35)
    FrameInput.BackgroundTransparency = 1
    FrameInput.Parent = tabFrames[aba]

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.6, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = "  " .. texto
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.SourceSans
    Label.TextSize = 16
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = FrameInput

    local TextBox = Instance.new("TextBox")
    TextBox.Size = UDim2.new(0.35, 0, 1, 0)
    TextBox.Position = UDim2.new(0.65, 0, 0, 0)
    TextBox.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    TextBox.Text = ""
    TextBox.PlaceholderText = "Nº"
    TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextBox.Font = Enum.Font.SourceSans
    TextBox.TextSize = 16
    TextBox.Parent = FrameInput

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 5)
    UICorner.Parent = TextBox

    TextBox.FocusLost:Connect(function()
        local num = tonumber(TextBox.Text)
        if num then callback(num) end
    end)
end
