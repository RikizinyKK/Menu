-- MOTOR DO ESP (CÁLCULO MATEMÁTICO DO RASTREADOR)
local camera = workspace.CurrentCamera
local localPlayer = game.Players.LocalPlayer

local function criarEspParaJogador(vendedor)
    if vendedor == localPlayer then return end
    local linha = Drawing.new("Line")
    linha.Visible = false
    linha.Color = Color3.fromRGB(0, 255, 150)
    linha.Thickness = 1.5
    
    local texto = Drawing.new("Text")
    texto.Visible = false
    texto.Color = Color3.fromRGB(255, 255, 255)
    texto.Size = 14
    texto.Center = true
    texto.Outline = true

    local conexao
    conexao = game:GetService("RunService").RenderStepped:Connect(function()
        if espAtivado and vendedor.Character and vendedor.Character:FindFirstChild("HumanoidRootPart") then
            local rootPart = vendedor.Character.HumanoidRootPart
            local posicaoTela, visivel = camera:WorldToViewportPoint(rootPart.Position)
            if visivel then
                linha.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                linha.To = Vector2.new(posicaoTela.X, posicaoTela.Y)
                linha.Visible = true
                texto.Position = Vector2.new(posicaoTela.X, posicaoTela.Y - 25)
                texto.Text = vendedor.Name
                texto.Visible = true
                return
            end
        end
        linha.Visible = false
        texto.Visible = false
        if not vendedor.Parent then
            linha:Remove()
            texto:Remove()
            conexao:Disconnect()
        end
    end)
end

game.Players.PlayerAdded:Connect(criarEspParaJogador)
for _, p in pairs(game.Players:GetPlayers()) do criarEspParaJogador(p) end

BtnEsp.MouseButton1Click:Connect(function()
    espAtivado = not espAtivado
    if espAtivado then BtnEsp.BackgroundColor3 = Color3.fromRGB(0, 255, 100); BtnEsp.Text = "ESP WALLHACK: ON"
