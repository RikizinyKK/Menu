-- SISTEMAS COMPORTAMENTAIS E INJEÇÃO DOS BOTÕES
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local boneco = LocalPlayer.Character
    if boneco then
        local humanoid = boneco:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if speedEnabled then humanoid.WalkSpeed = 100 end
            if jumpEnabled then humanoid.UseJumpPower = true humanoid.JumpPower = 70 end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if infiniteJumpEnabled then
        local boneco = LocalPlayer.Character
        local humanoid = boneco and boneco:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

local function AplicarESP(player)
    if player == LocalPlayer then return end
    local function adicionarHighlight(character)
        if not character then return end
        local antigo = character:FindFirstChild("XCHEAT_ESP") if antigo then antigo:Destroy() end
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "XCHEAT_ESP"
        Highlight.FillColor = Color3.fromRGB(255, 0, 0)
        Highlight.FillTransparency = 0.5
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.Enabled = espEnabled
        Highlight.Parent = character
    end
    adicionarHighlight(player.Character) player.CharacterAdded:Connect(adicionarHighlight)
end

local function AtualizarTodosESPs()
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then local hl = p.Character:FindFirstChild("XCHEAT_ESP") if hl then hl.Enabled = espEnabled end end end
end

local function AssistirJogador(targetPlayer)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
        espectandoPlayer = targetPlayer
        Camera.CameraSubject = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        SpectateLabel.Text = "ASSISTINDO: " .. targetPlayer.DisplayName:upper()
        SpectateLabel.Visible = true UnspectateBtn.Visible = true
    end
end

local function ResetarCamera()
    espectandoPlayer = nil local boneco = LocalPlayer.Character
    if boneco and boneco:FindFirstChildOfClass("Humanoid") then Camera.CameraSubject = boneco:FindFirstChildOfClass("Humanoid") end
    SpectateLabel.Visible = false UnspectateBtn.Visible = false
end

UnspectateBtn.MouseButton1Click:Connect(ResetarCamera)
RunService.RenderStepped:Connect(function() if espectandoPlayer then if not espectandoPlayer.Parent or not espectandoPlayer.Character or not espectandoPlayer.Character:FindFirstChildOfClass("Humanoid") or espectandoPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then ResetarCamera() end end end)

local function TeleportarPara(targetPlayer)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local meuBoneco = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local meuHRP = meuBoneco:WaitForChild("HumanoidRootPart")
        meuHRP.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 2, 0)
    end
end

-- CONFIGURAÇÃO DOS BOTÕES
CriarAlternador("WalkSpeed (100)", "PLAYER", function(ativo) speedEnabled = ativo if not ativo and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then LocalPlayer.Character.Humanoid.WalkSpeed = 16 end end)
CriarAlternador("JumpPower (70)", "PLAYER", function(ativo) jumpEnabled = ativo if not ativo and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then LocalPlayer.Character.Humanoid.JumpPower = 50 end end)
CriarAlternador("Pulo Infinito", "PLAYER", function(ativo) infiniteJumpEnabled = ativo end)
CriarAlternador("Noclip", "PLAYER", function(ativo) noclipEnabled = ativo if ativo then noclipConnection = RunService.Stepped:Connect(function() if noclipEnabled and LocalPlayer.Character then for _, part in pairs(LocalPlayer.Character:GetDescendants()) do if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end end end end) else if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then LocalPlayer.Character.HumanoidRootPart.CanCollide = true end end end)
CriarAlternador("ESP Jogadores", "PLAYER", function(ativo) espEnabled = ativo table.defer(AtualizarTodosESPs) end)
CriarInputNumero("Definir HipHeight:", "PLAYER", function(valor) if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then LocalPlayer.Character.Humanoid.HipHeight = valor end end)
CriarBotao("Sentar (Sit)", "TROLL", function() if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then LocalPlayer.Character.Humanoid.Sit = true end end)
CriarAlternador("Gravidade (20)", "TROLL", function(ativo) gravityEnabled = ativo workspace.Gravity = ativo and 20 or padraoGravidade end)

-- SINCRONIZAÇÃO DAS LISTAS
local function AtualizarListasMecanicas()
    for _, child in ipairs(tabFrames["TELEPORTE"]:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    for _, child in ipairs(tabFrames["ESPECTAR"]:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then CriarBotao(p.DisplayName .. " (@" .. p.Name .. ")", "TELEPORTE", function() TeleportarPara(p) end) CriarBotao("Espectar: " .. p.DisplayName, "ESPECTAR", function() AssistirJogador(p) end) end end
end

Players.PlayerAdded:Connect(function(p) AplicarESP(p) table.defer(AtualizarListasMecanicas) end)
Players.PlayerRemoving:Connect(function() table.defer(AtualizarListasMecanicas) end)
for _, p in ipairs(Players:GetPlayers()) do AplicarESP(p) end
AtualizarListasMecanicas()
